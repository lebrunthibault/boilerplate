# RUNTIME — environnement d'exécution. "production" (serveur de prod) durcit la sécurité : cookie
# de session Secure + __Host-, rate limit public, purge de rétention, refus de démarrer sans
# ALLOWED_ORIGINS ni SERVICE_API_KEY. "local" (défaut) ou "test" sinon. Toute autre valeur
# empêche le démarrage. À METTRE À "production" dans le .env du serveur.
APP_ENV=local

# DATABASE — Postgres du docker-compose de dev (publié sur 5433). Dans les conteneurs, le compose
# surcharge cette valeur avec l'hôte interne.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/app

# LOGFIRE (observabilité) — DÉSACTIVÉ par défaut. La télémétrie n'est envoyée que si
# LOGFIRE_ENABLED=true. Même activée, aucun corps/header HTTP n'est capturé.
LOGFIRE_ENVIRONMENT=local
LOGFIRE_ENABLED=
# Jeton d'écriture, lu directement par le SDK logfire (jamais par notre code).
LOGFIRE_TOKEN=

# CORS
# Liste d'origines autorisées séparées par des virgules. Vide = origines de dev local uniquement
# (jamais "*"). REQUIS en prod (APP_ENV=production refuse de démarrer sans) — même si le frontend
# est same-origin, on fixe la valeur explicitement.
# Prod: ALLOWED_ORIGINS=https://example.com
ALLOWED_ORIGINS=

# AUTH
# Comptes admin en base (table `admin`) : login par email + mot de passe argon2, créé via
# `make create-admin email=…` — requis en dev comme en prod (pas de mode sans auth). Sessions
# serveur opaques en base (table `admin_session`) : aucun secret de signature nécessaire.

# API PUBLIQUE — clé partagée exigée (header X-API-Key) par les routes publiques appelées par un
# client tiers (cf. app/api_key.py, route d'exemple POST /api/ping). Vide = routes ouvertes (dev).
# REQUISE en prod (APP_ENV=production refuse de démarrer sans). Générer : openssl rand -hex 32.
SERVICE_API_KEY=
# Requêtes par minute et par IP sur ces routes (prod uniquement).
RATE_LIMIT_PUBLIC_PER_MINUTE=20

# POSTGRES (for docker-compose.prod.yml)
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app

# Stockage objet S3 (sauvegardes)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
# Clé PUBLIQUE age (age1...) qui chiffre les sauvegardes côté client avant envoi S3. La clé privée
# n'est ni dans le dépôt ni sur le serveur : poste de dev + gestionnaire de mots de passe
# (procédure et rotation : docs/ops/backups.md). REQUISE en prod (deploy.sh refuse une valeur vide).
BACKUP_AGE_RECIPIENT=
