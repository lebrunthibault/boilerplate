FROM python:3.12-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY src/api/ src/api/
RUN uv sync --frozen --no-dev --no-editable

FROM python:3.12-slim
WORKDIR /app
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/src/api src/api/
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"
EXPOSE 8000
# exec : uvicorn remplace sh comme PID 1 et reçoit SIGTERM → shutdown gracieux
# (lifespan : arrêt des tâches de fond, fermeture du pool) ; sans exec, sh n'aurait pas transmis le signal.
CMD ["sh", "-c", "alembic -c src/api/alembic.ini upgrade head && exec uvicorn api.main:app --host 0.0.0.0 --port 8000"]
